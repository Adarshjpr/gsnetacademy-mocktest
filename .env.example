# Copy this file to .env and change the values:  cp .env.example .env

# Port on the server where the website opens (80 = normal http://your-ip)
APP_PORT=80

# Address people use to open the site (your domain or http://server-ip)
PUBLIC_URL=http://localhost

# Long random secret for login tokens (at least 32 characters).
# Make one with:  openssl rand -hex 32
JWT_SECRET=replace_with_a_long_random_string_of_at_least_32_chars

# First admin login (created automatically on first start)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeThisPassword@123

# Keep false for plain http://. Set true only after HTTPS (SSL) is working.
COOKIE_SECURE=false
